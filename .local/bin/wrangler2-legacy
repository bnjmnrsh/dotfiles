#!/bin/sh
set -eu

volta_home="${VOLTA_HOME:-$HOME/.volta}"
entry="$HOME/.local/share/volta-legacy-tools/wrangler-2.1.6/node_modules/wrangler/bin/wrangler.js"

if [ ! -x "$volta_home/bin/volta" ] || [ ! -r "$entry" ]; then
  printf '%s\n' 'wrangler2-legacy dependencies are missing; follow the global tools recovery steps in ~/README.md.' >&2
  exit 127
fi

exec "$volta_home/bin/volta" run --node 18.16.0 --bundled-npm node "$entry" "$@"
