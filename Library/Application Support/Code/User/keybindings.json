// Place your key bindings in this file to override the defaults
[
  /**
   * File explorer, and set focus
   **/
  {
    "key": "cmd+k cmd+e",
    "command": "workbench.files.action.focusFilesExplorer"
  },
    {
    "key": "cmd+k cmd+g",
    "command": "vscode-chatgpt.view.focus"
  },
  /**
   * File explorer specific shortcuts
   **/
  {
    "key": "cmd+k e",
    "command": "-workbench.files.action.focusOpenEditorsView",
    "when": "workbench.explorer.openEditorsView.active"
  },
  {
    "key": "cmd+d",
    "command": "duplicate.execute",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !inputFocus"
  },
  {
    "key": "cmd+n",
    "command": "explorer.newFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+cmd+n",
    "command": "explorer.newFolder",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "cmd+r",
    "command": "workbench.files.action.refreshFilesExplorer",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  /**
   * Debugger
   **/
  {
    "key": "cmd+k cmd+d",
    "command": "workbench.view.debug"
  },
  /**
   * Extensions
   **/
  {
    "key": "cmd+k cmd+x",
    "command": "workbench.view.extensions"
  },
  /**
   * Git interface
   **/
  {
    "key": "cmd+k cmd+v",
    "command": "workbench.view.scm"
  },
  /**
   * Git commit shortcut
   **/
  {
    "key": "cmd+enter",
    "command": "git.commit",
    "when": "activeViewlet == 'workbench.view.scm'"
  },

  /**
   * Terminal
   **/
  {
    "key": "cmd+t",
    "command": "workbench.action.terminal.toggleTerminal"
  },
  {
    "key": "cmd+k cmd+t",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "cd '${fileDirname}'\u000D" },
     //"when": "terminalFocus"
  },
  // for micro do nothing
  { "key": "ctrl+q", "command": "", "when": "!terminalFocus" },

  {
    "key": "cmd+k cmd+k",
    "command": "workbench.action.terminal.clear",
    "when": "terminalFocus && terminalProcessSupported"
},
{
    "key": "shift+cmd+c shift+cmd+c",
    "command": "phpCreateClass.createClass"
},
{
    "key": "shift+cmd+i shift+cmd+i",
    "command": "phpCreateClass.createInterface"
},
{
    "key": "shift+cmd+t shift+cmd+t",
    "command": "phpCreateClass.createTrait"
},
{
    "key": "alt+cmd+/",
    "command": "editor.action.inlineSuggest.trigger",
    "when": "editorTextFocus && !editorHasSelection && !inlineSuggestionsVisible"
},
{
    "key": "alt+\\",
    "command": "-editor.action.inlineSuggest.trigger",
    "when": "editorTextFocus && !editorHasSelection && !inlineSuggestionsVisible"
},
{
    "key": "alt+c",
    "command": "editor.action.submitComment",
    "when": "commentEditorFocused"
},
{
    "key": "shift+cmd+enter",
    "command": "-editor.action.submitComment",
    "when": "commentEditorFocused"
},
{
    "key": "alt+cmd+b",
    "command": "-notification.acceptPrimaryAction",
    "when": "notificationFocus || notificationToastsVisible"
},
{
    "key": "cmd+k cmd+m",
    "command": "workbench.action.toggleMaximizeEditorGroup",
    "when": "editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups"
},
{
    "key": "alt+cmd+a",
    "command": "notification.acceptPrimaryAction",
    "when": "notificationFocus || notificationToastsVisible"
},
{
    "key": "shift+cmd+a",
    "command": "-notification.acceptPrimaryAction",
    "when": "notificationFocus || notificationToastsVisible"
},
{
    "key": "shift+cmd+l",
    "command": "vscode-augment.focusAugmentPanel"
},
{
    "key": "ctrl+cmd+i",
    "command": "-vscode-augment.focusAugmentPanel"
},
{
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
        "text": "\r\n"
    },
    "when": "terminalFocus"
},
{
    "key": "alt+cmd+k alt+cmd+z",
    "command": "workbench.action.toggleZenMode",
    "when": "!isAuxiliaryWindowFocusedContext"
},
{
    "key": "cmd+k z",
    "command": "-workbench.action.toggleZenMode",
    "when": "!isAuxiliaryWindowFocusedContext"
},
{
    "key": "alt+cmd+k alt+cmd+m",
    "command": "workbench.action.toggleMaximizeEditorGroup",
    "when": "editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups"
},
{
    "key": "alt+cmd+h",
    "command": "workbench.action.maximizeEditorHideSidebar"
},
{
    "key": "alt+cmd+n",
    "command": "workbench.action.toggleSidebarVisibility"
},
{
    "key": "cmd+k cmd+m",
    "command": "-workbench.action.toggleMaximizeEditorGroup",
    "when": "editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups"
},
{
    "key": "cmd+b",
    "command": "-workbench.action.toggleSidebarVisibility"
},
{
    "key": "cmd+t",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
},
{
    "key": "ctrl+`",
    "command": "-workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
},
{
    "key": "alt+cmd+o shift+alt+cmd+o",
    "command": "git.openRepository",
    "when": "!operationInProgress"
},
]
