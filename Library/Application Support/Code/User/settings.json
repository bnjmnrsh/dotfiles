{
    "emmet.syntaxProfiles": {
    "tpl": "html"
    },
    "emmet.includeLanguages": {
        "smarty": "html"
    },
    "emmet.triggerExpansionOnTab": true,
    "files.defaultLanguage": "js",
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.inc": "html",
        "*.pinc": "html",
        "*.tmpl": "smarty",
        "*.php": "php",
        ".babelrc.js": "javascript",
        "*.hbs": "handlebars",
        "*.mjs": "javascript"
    },

    "auto-close-tag.fullMode": true,
    "auto-close-tag.SublimeText3Mode": true,

    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,

    // Language: PHP
    "php.suggest.basic":false,
    "php-docblocker.returnGap": true,
    "php-docblocker.alignParams": true,
    "php-docblocker.alignReturn": true,
    "php-docblocker.useShortNames": true,
    "phpfmt.passes": ["AlignPHPCode"],
    "phpserver.phpConfigPath": "./php.ini ",
    "phpCreateClass.finalClass": true,
    "phpCreateClass.strictTypes": true,

    "namespaceResolver.sortNatural": true,
    "namespaceResolver.sortAlphabetically": true,
    "namespaceResolver.sortOnSave": true,
    "php.validate.executablePath": "/usr/local/bin/php",



    "smarty.highlight": true,
    "beautify.language": {
        "html": ["smarty"]
    },

    // Language: HTML
    "html.validate.scripts": false,
    "html.format.endWithNewline": false,
    "html.format.wrapAttributes": "auto",
    "html.format.wrapLineLength": 120,
    "html.format.indentHandlebars": true,

    // Language: JavaScript / Typescript
    "javascript.validate.enable": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "javascript.format.enable": false,
    "typescript.tsserver.log": "off",

    "standard.usePackageJson": true,
    "eslint.format.enable": true,

    // Language: JSON

    // Language: CSS/SCSS/LESS
    // WATCH FOR COLLISIONS WITH STYLELINT
    "scss.lint.zeroUnits": "warning",
    "scss.lint.ieHack": "warning",
    "scss.lint.idSelector": "warning",
    "scss.lint.hexColorLength": "warning",
    "scss.lint.duplicateProperties": "warning",
    "scss.lint.compatibleVendorPrefixes": "warning",
    "scss.lint.boxModel": "warning",
    "scss.lint.universalSelector": "warning",
    "scss.lint.importStatement": "warning",
    "scss.lint.important": "warning",

    "less.validate": false,
    "css.validate": false,
    "stylelint.validate": [
        "css",
        "html",
        // "javascriptreact",
        "less",
        "markdown",
        "postcss",
        "sass",
        "scss",
        "source.css.styled",
        "source.markdown.math",
        "styled-css",
        "sugarss",
        "typescriptreact",
        "vue",
        "vue-html",
        "vue-postcss",
        "svelte",
        "astro",
        "xml",
        "xsl",
    ],
    "stylelint.reportNeedlessDisables": true,
    "stylelint.reportInvalidScopeDisables": true,

    // Spelling
    "spellright.language": [
        "en_GB",
        "en"
    ],
    "spellright.documentTypes": [
        "latex",
        "plaintext",
        "html",
        "php",
        "javascript",
        "css",
        "scss"
    ],
    "spellright.groupDictionaries": false,
    "spellright.suggestionsInHints": true,
    "spellright.recheckOnSave": true,
    "spellright.languageContext": {
        "strings": [ "en-GB" ],
        "comments": [ "en-GB" ]
    },


    // Formatters
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[xml]": {},
    "[javascript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[php]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "StoilDobreff.php-resolver",
    },
    "[smarty]": {
        // "editor.defaultFormatter": "aswinkumar863.smarty-template-support",
    },
    "[css]": {
        "breadcrumbs.showConstants": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[handlebars]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[svelte]": {
        "editor.defaultFormatter": "svelte.svelte-vscode"
    },

    "prettier.requireConfig": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.sideBar.location": "right", // Medium
    "workbench.statusBar.visible": true,
    "breadcrumbs.enabled": true,

    // A nice font
    // "editor.fontFamily": "Inconsolata, Menlo, Monaco, 'Courier New', monospace",
    // "editor.fontFamily": "Inconsolata for Powerline",
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.fontWeight": "500",
    "editor.accessibilitySupport": "off",
    "editor.suggest.shareSuggestSelections": true,
    "editor.inlineSuggest.enabled": true,
    "editor.suggestSelection": "first",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.bracketPairColorization.enabled": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.renderWhitespace": "none",
    "editor.detectIndentation": false,
    "editor.minimap.enabled": false,
    "editor.linkedEditing": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "explorer.confirmDragAndDrop": false,
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",

    // Color
    "colorInfo.languages": [
        {
            "selector": "js",
            "colors": "css"
        },
        {
            "selector": "css",
            "colors": "css"
        },
        {
            "selector": "sass",
            "colors": "css"
        },
        {
            "selector": "scss",
            "colors": "css"
        },
        {
            "selector": "less",
            "colors": "css"
        },
        {
            "selector": "hbs",
            "colors": "css"
        },
        {
            "selector": "astro",
            "colors": "css"
        },
    ],

    // Git
    "git.autofetch": true,
    "git.suggestSmartCommit": false,
    "git.confirmSync": false,
    "git.allowForcePush": true,
    "git.ignoreRebaseWarning": true,
    "yaml.schemas": {
        "file:///Users/anachronistic/.vscode/extensions/atlassian.atlascode-3.0.10/resources/schemas/pipelines-schema.json": "bitbucket-pipelines.yml"
    },
    "atlascode.bitbucket.enabled": true,
    "atlascode.jira.enabled": true,
    "github.copilot.enable": {
        "*": false,
        "yaml": false,
        "plaintext": true,
        "markdown": false,
        "php": true,
        "javascript": false
    },

    // terminal
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.external.osxExec": "iTerm.app",
    "terminal.integrated.fontFamily": "Inconsolata for Powerline",
    "terminal.integrated.fontWeightBold": "bold",
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.macOptionClickForcesSelection": true,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.defaultColor": "terminal.ansiGreen",

    "liveServer.settings.donotVerifyTags": true,
    "liveServer.settings.donotShowInfoMsg": true,

    "todo-tree.general.statusBar": "tags",
    "todo-tree.general.showActivityBarBadge": true,

    "redhat.telemetry.enabled": true,
    "vscode-edge-devtools.mirrorEdits": true,
    "npm.keybindingsChangedWarningShown": true,
    "tabnine.experimentalAutoImports": true,
    "vscode-edge-devtools.browserFlavor": "Default",
    "spellright.configurationScope": "user",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.8,
    "editor.fontVariations": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.preferredDarkColorTheme": "Bnjmnrsh Solarized Light",

    "xmlTools.enforcePrettySelfClosingTagOnFormat": true,
    "xmlTools.splitAttributesOnFormat": true,
    "application.shellEnvironmentResolutionTimeout": 20,
    "genieai.response.showNotification": true,
    "genieai.promptPrefix.adhoc-enabled": false,

    "svelte.enable-ts-plugin": true,
    "svg.preview.mode": "svg",
    "[svg]": {

        "editor.defaultFormatter": "jock.svg"
    },
    "editor.inlineSuggest.suppressSuggestions": true,
    "git.openRepositoryInParentFolders": "always",
    "explorer.confirmDelete": false,
    "phpsab.executablePathCBF": "phpcbf",
    "phpsab.executablePathCS": "phpcs",
    "phpsab.debug": true,
    "namespaceResolver.sort.onSave": true,
    "namespaceResolver.sort.natural": true,
    "Prettier-SQL.keywordCase": "upper",
    "Prettier-SQL.tabulateAlias": true,
    "[sql]": {
        "editor.defaultFormatter": "dorzey.vscode-sqlfluff"
    },
    "sqltools.autoConnectTo": "",
    "sqltools.connections": [],
    "sqltools.format": {
        "linesBetweenQueries": 2,
        "reservedWordCase": "upper"
    },
    "SQL-Formatter-VSCode.dialect": "mysql",
    "intelephense.environment.phpVersion": " 8.2.15 ",
    "intelephense.format.enable": false,
    "cody.commandCodeLenses": true,
    "cody.autocomplete.formatOnAccept": true,
    "sqlfluff.dialect": "mysql",
    "sqlfluff.format.languages": [
        "sql",
        "mysql",
        "postgres"
    ],
    "cssvar.postcssPlugins": [],
    "cSpell.userWords": [
        "atlascode",
        "smacss"
    ],
    "cSpell.customDictionaries": {
        "custom-dictionary-user": {
            "name": "custom-dictionary-user",
            "path": "~/.cspell/custom-dictionary-user.txt",
            "addWords": true,
            "scope": "user"
        }
    },
    "cSpell.enabledLanguageIds": [
        "asciidoc",
        "c",
        "cpp",
        "csharp",
        "css",
        "elixir",
        "erlang",
        "git-commit",
        "go",
        "graphql",
        "handlebars",
        "haskell",
        "html",
        "jade",
        "java",
        "javascript",
        "javascriptreact",
        "json",
        "jsonc",
        "jupyter",
        "latex",
        "less",
        "markdown",
        "php",
        "plaintext",
        "python",
        "pug",
        "restructuredtext",
        "rust",
        "scala",
        "scss",
        "scminput",
        "swift",
        "text",
        "typescript",
        "typescriptreact",
        "vue",
        "yaml",
        "yml",
        "astro"
    ],
    "cSpell.experimental.enableSettingsViewerV2": true,
    "cSpell.language": "en,en-GB,lorem",
    "cSpell.enableFiletypes": [
        "!c",
        "!cpp",
        "!csharp",
        "!go",
        "!json",
        "!python",
        "!scala",
        "PHPLog",
        "ignore",
        "sass",
        "sass.hover",
        "sql",
        "styled-css",
        "svelte",
        "svg",
        "xml"
    ],
    "diffEditor.maxComputationTime": 0,
    "cSpell.showAutocompleteSuggestions": true,
    "spellright.ignoreFiles": [
        "**/.gitignore",
        "**/.spellignore"
    ],
    "spellright.notificationClass": "warning",
    "html.format.enable": false,
    "supermaven.otherWarning": false,
    "prettier.bracketSpacing": false,
    "prettier.configPath": ".prettierrc",
    "[astro]": {
        "editor.defaultFormatter": "astro-build.astro-vscode"
    },
    "workbench.preferredLightColorTheme": "Bnjmnrsh Solarized Light",
    "cssCustomProperties.languages": [
        "css", "scss", "less", "astro"
    ],
    "cssCustomProperties.files": [
        "./src/*.css", "./src/*.astro", "./vendor/*.css"
    ],
    "workbench.colorTheme": "Bnjmnrsh Solarized Light",
    "workbench.iconTheme": "material-icon-theme",
    "spellright.addToSystemDictionary": true,
    "cssVariables.lookupFiles": [
        "./src/*.css",
        "./src/*.astro",
        "./dist/*.sass",
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less"
    ],
    "cssVariables.languages": [
        "astro",
        "svelte",
        "vue",
        "vue-html",
        "vue-postcss",
        "scss",
        "postcss",
        "less",
        "css",
        "html",
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "source.css.styled"
    ],
    "codeium.searchMaxWorkspaceFileCount": 3000,
    "codeium.aggressiveShutdown": true,
    "codeium.enableConfig": {
        "*": true,
        "Log": true
    },
}
